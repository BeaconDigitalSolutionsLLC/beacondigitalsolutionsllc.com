# macOS
.DS_Store

# Editor / OS junk
*.log
Thumbs.db
*.swp

# Optional future
node_modules/
dist/
build/

# Secrets — NEVER commit these
.env
*.env

# Backend database (customer emails + license keys live here).
# This repo is public + served by GitHub Pages, so the DB must never be
# committed. In production it lives on the backend host's persistent disk.
licenses.db
*.sqlite
*.sqlite3

# Beta app binaries (host these as GitHub Releases / CDN, not in the repo)
downloads/*.zip
downloads/*.dmg

# Python
__pycache__/
*.pyc
venv/
.venv/

# Business strategy — this repo is public and is served at the live domain,
# so anything tracked here is readable by anyone (including competitors).
GROWTH_PLAN.md
MARKETING_ROLLOUT.md

# Screenshot redaction scripts: they contain the real names and account
# labels they exist to remove. Never track these.
marketing/*.swift
